# ─────────────────────────────────────────────────────────────────────────────
#  Smart College Placement — Root .env
#  Copy to .env and fill in real values BEFORE running docker compose.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=RootP@ssw0rd_change_me
MYSQL_DATABASE=smart_placement
MYSQL_USER=placement_user
MYSQL_PASSWORD=Placement@Pass_change_me

# ── Flask / JWT ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-64-char-random-hex-string
JWT_SECRET_KEY=change-this-jwt-secret-to-a-64-char-random-hex-string

# ── Flask environment ─────────────────────────────────────────────────────────
FLASK_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# In Docker Compose the frontend proxies /api so just add your public domain.
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost

# ── React build ───────────────────────────────────────────────────────────────
# With Docker Compose + Nginx reverse-proxy, keep this as /api (same-origin).
# For separate deployments, use the full backend URL.
VITE_API_URL=/api
