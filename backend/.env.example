# ── Flask ──────────────────────────────────────────────────────────────────
# development | production | testing
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-64-char-random-hex-string
JWT_SECRET_KEY=change-this-jwt-secret-to-a-64-char-random-hex-string

# ── MySQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:your_password@localhost/smart_placement

# ── File Storage ──────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
REPORTS_FOLDER=reports

# ── CORS (comma-separated, no trailing slash) ─────────────────────────────
# Use * for open access, or restrict to your domain in production
CORS_ORIGINS=*

# ── Gunicorn (optional overrides) ─────────────────────────────────────────
GUNICORN_WORKERS=5
GUNICORN_THREADS=2
LOG_LEVEL=info
